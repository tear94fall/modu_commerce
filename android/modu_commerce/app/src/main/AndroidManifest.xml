<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 웹을 못 열었을 때 인터넷 연결 여부를 보고, 연결이 돌아오면 자동으로 다시 불러온다 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 모두의 채팅이 signature 보호로 여는 SSO 액티비티를 부르기 위한 권한. 같은 키로 서명돼야 얻는다. -->
    <uses-permission android:name="com.example.modumessenger.permission.SSO" />

    <!-- Android 11+ 패키지 가시성: 채팅 앱이 설치돼 있는지 보고 인텐트를 보낼 수 있게 한다. -->
    <queries>
        <package android:name="com.example.modumessenger" />
    </queries>

    <application
        android:name=".CommerceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ModuCommerce"
        android:usesCleartextTraffic="true">

        <!-- 하나뿐인 액티비티. 스플래시 유지 → 세션 판정 → NavHost.
             회전·접기(화면 크기 변화)는 액티비티를 다시 만들지 않고 Compose 가 새 크기로 다시 그린다.
             다시 만들면 WebView 가 새로 생겨 웹 앱이 처음부터 다시 로드되고 보던 화면·입력이 사라진다. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ModuCommerce.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
