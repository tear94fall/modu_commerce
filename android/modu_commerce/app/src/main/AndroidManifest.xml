<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 모두의 채팅이 signature 보호로 여는 SSO 액티비티를 부르기 위한 권한. 같은 키로 서명돼야 얻는다. -->
    <uses-permission android:name="com.example.modumessenger.permission.SSO" />

    <!-- Android 11+ 패키지 가시성: 채팅 앱이 설치돼 있는지 보고 인텐트를 보낼 수 있게 한다. -->
    <queries>
        <package android:name="com.example.modumessenger" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
