<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 앱 기본 테마. Compose 가 색을 그리므로 여기서는 시스템 바 색만 맞춘다. -->
    <style name="Theme.ModuCommerce" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@color/on_brand_red</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_red_dark</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- 런처 테마. core-splashscreen 이 로고를 그리고 installSplashScreen() 이후 기본 테마로 갈아탄다. -->
    <style name="Theme.ModuCommerce.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ModuCommerce</item>
    </style>
</resources>
