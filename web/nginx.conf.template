# 커머스 웹 정적 서빙 + API 프록시. 브라우저·WebView 는 같은 출처만 부르므로 서버 CORS 설정이 필요 없다.
#
# 이 파일은 템플릿이다. 공식 nginx 이미지가 기동할 때 envsubst 로 /etc/nginx/conf.d/default.conf 를 만든다
# (정의된 환경변수만 바꾸므로 $host 같은 nginx 변수는 그대로 남는다).
#
# 뒤쪽 서비스 주소는 이름으로만 적고 nginx 가 주기적으로 다시 조회한다(upstream server ... resolve, nginx 1.27.3+).
# 예전에는 기동 때 한 번만 IP 로 바꿔 붙잡아서, 서비스가 재배포돼 IP 가 바뀌면 502 였고(2026-09-24 gateway·commerce-service),
# nginx 가 뜰 때 대상이 아직 없으면 nginx 자체가 기동에 실패했다. 이제 기동 순서·재배포와 무관하다.
# DNS 서버는 하드코딩하지 않는다: NGINX_ENTRYPOINT_LOCAL_RESOLVERS(Dockerfile) 로 컨테이너의 /etc/resolv.conf 를 읽어
# NGINX_LOCAL_RESOLVERS 에 넣는다(Docker 면 127.0.0.11, 쿠버네티스면 클러스터 DNS).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

upstream gateway {
    zone gateway 64k;
    server gateway-service:8000 resolve;
}

upstream storage {
    zone storage 64k;
    server storage-service:9999 resolve;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 카탈로그·장바구니·주문: 게이트웨이의 commerce-service 경로(/commerce-service/api-public/**)로.
    # 게이트웨이가 토큰(ROLE_USER, aud modu-commerce)을 확인하고 modu.services.commerce-service 주소로 넘긴다. Authorization 은 그대로 넘어가고,
    # 게이트웨이 CORS 가 다른 출처를 막으므로(POST·PUT 등은 같은 출처여도 Origin 이 붙는다) Origin 은 지운다.
    location /api-public/ {
        proxy_pass http://gateway/commerce-service/api-public/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin "";
        proxy_read_timeout 60s;
    }

    # 토큰 발급·갱신·userinfo: 게이트웨이 뒤의 auth-service. 게이트웨이 CORS 가 다른 출처를 막으므로 Origin 은 지우고 넘긴다.
    location /auth-service/ {
        proxy_pass http://gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin "";
        proxy_read_timeout 60s;
    }

    # 프로필 사진(공개 다운로드). 게이트웨이는 토큰을 요구하므로 storage-service 로 바로 간다.
    location /storage-service/ {
        proxy_pass http://storage/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # index.html 은 매번 새로 확인한다(해시 붙은 assets 만 오래 캐시). 안 그러면 배포 뒤에도 브라우저가 옛 화면을 띄운다.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
